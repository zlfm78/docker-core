# syntax=docker/dockerfile:1

#stage 01: build
FROM golang:1.27-alpine AS build

WORKDIR /src

COPY main.go ./
RUN go build -o /out/hello main.go

#stage 02: runtime
FROM alpine:3.24 AS runtime

WORKDIR /app

RUN addgroup -S -g 10001 app && adduser -S -D -H -u 1001 -G app app 

COPY --from=build /out/hello ./

USER 1001:10001

CMD ["./hello"]